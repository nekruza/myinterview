# Fina Web — environment variables
#
# Copy to .env.local and fill in real values for local development.
# Every variable below is read somewhere in app/, lib/, components/,
# middleware.ts or next.config.ts — verified with:
#   grep -rhoE "process\.env\.[A-Z_]+" app lib components middleware.ts next.config.ts | sort -u
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time;
# everything else stays server-only.

# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL and anon key for the browser client, the SSR server client,
# and the auth-cookie-refresh middleware. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-only, never exposed to the client. Used for the
# Stripe webhook (writing Pro status), the Stripe verify-purchase redirect,
# and account deletion (removing the auth.users row). Lazily constructed —
# a missing key logs an error and degrades gracefully instead of crashing
# the module at build/import time.
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM providers ─────────────────────────────────────────────────────────
# Primary conversation + feedback + vocabulary-generation model
# (Google Gemini). streamLLM() falls back to OpenAI on any Gemini error.
GOOGLE_GEMINI_API_KEY=

# LLM fallback used automatically when the Gemini stream throws.
OPENAI_API_KEY=

# ── Inworld (voice) ───────────────────────────────────────────────────────
# Server-side key for the realtime WebRTC ICE/SDP proxy (/api/realtime/*)
# and the TTS proxy (/api/tts). Never sent to the browser.
INWORLD_API_KEY=

# Optional default TTS voice id, used when a tutor/language has none set.
INWORLD_VOICE_ID=

# Set to "true" to enable WebRTC realtime voice (VoiceCallView + Inworld).
# Any other value (or unset) falls back to the Web Speech recognition +
# SSE token streaming path.
NEXT_PUBLIC_INWORLD_REALTIME_ENABLED=

# ── TTS fallback ──────────────────────────────────────────────────────────
# Optional Kokoro TTS fallback via Chutes AI, used by /api/tts when Inworld
# fails. If unset, that fallback tier is skipped.
CHUTES_API_KEY=

# ── Stripe (Fina Pro subscription) ───────────────────────────────────────
# Secret key for Checkout, the billing portal, the webhook, verify-purchase,
# and cancelling a subscription on account deletion.
STRIPE_SECRET_KEY=

# Signing secret used to verify /api/stripe/webhook request signatures.
STRIPE_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────────────────────
# Absolute origin used for Stripe success/cancel URLs and Next's metadataBase.
# Falls back to the request origin when unset.
NEXT_PUBLIC_APP_URL=

# ── Analytics ─────────────────────────────────────────────────────────────
# Optional Mixpanel project token. Analytics is a no-op when unset.
NEXT_PUBLIC_MIXPANEL_TOKEN=
